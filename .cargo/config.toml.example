# Build adk-ui 3 against an adk-rust checkout until ADK-Rust 3.0 is on crates.io.
#
#   cp .cargo/config.toml.example .cargo/config.toml   # untracked
#
# Set the paths to an adk-rust checkout of `main` (genui extension catalogs landed in
# zavora-ai/adk-rust#1393). Remove this file once ADK-Rust 3.0 is on crates.io.

[patch.crates-io]
adk-core = { path = "../adk-rust/adk-core" }
adk-surface = { path = "../adk-rust/adk-surface" }
