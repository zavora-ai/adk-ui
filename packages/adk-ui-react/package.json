{
    "name": "@zavora-ai/adk-ui-react",
    "version": "3.0.0",
    "description": "Renderers of adk-ui's extension catalogs (charts, metrics, apps, pages) for @zavora-ai/adk-surface-react's DrawnView, and the same components for a host's own data",
    "keywords": [
        "adk",
        "adk-rust",
        "agent",
        "a2ui",
        "genui",
        "generative-ui",
        "charts",
        "react",
        "zavora"
    ],
    "homepage": "https://github.com/zavora-ai/adk-ui/tree/main/packages/adk-ui-react#readme",
    "bugs": {
        "url": "https://github.com/zavora-ai/adk-ui/issues"
    },
    "license": "Apache-2.0",
    "author": "Zavora Technologies Ltd",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zavora-ai/adk-ui.git",
        "directory": "packages/adk-ui-react"
    },
    "engines": {
        "node": ">=20"
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./style.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "dev": "node scripts/build.mjs --watch",
        "lint": "eslint src/",
        "prepublishOnly": "npm run lint && npm run typecheck && npm test",
        "pretest": "npm run build",
        "test": "node --test ./test/*.cjs",
        "typecheck": "tsc --noEmit",
        "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\""
    },
    "peerDependencies": {
        "@zavora-ai/adk-surface-react": "^3.0.0",
        "react": ">=18.3.0 <20",
        "react-dom": ">=18.3.0 <20",
        "recharts": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "@zavora-ai/adk-surface-react": {
            "optional": true
        },
        "recharts": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^16.5.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "recharts": "^3.10.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4"
    },
    "publishConfig": {
        "access": "public"
    }
}
