{
  "catalog": "spatial",
  "summary": "Services as a network in layers (edge, core, data) beside a card whose back holds the details.",
  "screen": {
    "surfaceId": "services",
    "title": "Checkout and its dependencies",
    "components": [
      {
        "id": "root",
        "component": "Row",
        "children": [
          "graph",
          "latency-card"
        ]
      },
      {
        "id": "graph",
        "component": "Graph3D",
        "title": "Services",
        "description": "Edge above core above data",
        "nodes": {
          "path": "/nodes"
        },
        "edges": {
          "path": "/edges"
        },
        "layout": "layers",
        "height": 400
      },
      {
        "id": "latency-card",
        "component": "DepthCard",
        "title": "Checkout latency",
        "effect": "flip",
        "front": "latency",
        "back": "latency-detail"
      },
      {
        "id": "latency",
        "component": "Metric",
        "label": "p95 latency",
        "value": {
          "path": "/p95"
        },
        "unit": "ms",
        "delta": {
          "value": 430,
          "goodWhen": "down"
        }
      },
      {
        "id": "latency-detail",
        "component": "KeyValue",
        "title": "Since 09:00",
        "items": [
          {
            "key": "Slowest call",
            "value": "payments.authorize"
          },
          {
            "key": "Error rate",
            "value": "0.8%"
          },
          {
            "key": "Deploy",
            "value": "checkout 4.12.0 at 08:55"
          }
        ]
      }
    ],
